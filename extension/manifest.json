{
  "manifest_version": 3,
  "name": "TaylorMade Clipboard",
  "version": "0.1.0",
  "description": "Text expander, right-click paste and copy-source reporting for the TaylorMade Agent Monitor clipboard history. Talks only to the local app over native messaging; nothing leaves this machine.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "128": "icon-128.png" },
  "permissions": ["nativeMessaging", "contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/expander-core.js", "content/page.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
