{
  "name": "taylormade-agent-monitor",
  "version": "0.2.1",
  "description": "Hotkey-summoned Claude and Codex agent monitor for Windows.",
  "author": "Taylor",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "focus:diag": "node scripts/focus-diag.mjs",
    "icons": "node scripts/build-icon.mjs",
    "hooks:install": "node hooks/install.mjs",
    "hooks:codex": "node hooks/install.mjs --provider codex",
    "dist": "npm run build && npm run icons && electron-builder --win",
    "dist:dir": "npm run build && npm run icons && electron-builder --win --dir",
    "publish": "npm run build && npm run icons && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.0.2",
    "mongodb": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  }
}
