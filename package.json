{
  "name": "taylormade-agent-monitor",
  "version": "0.3.1",
  "description": "Hotkey-summoned Claude Code, Codex, and Cursor agent monitor for Windows.",
  "author": "Taylor",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "focus:diag": "node scripts/focus-diag.mjs",
    "icons": "node scripts/build-icon.mjs",
    "hooks:install": "node hooks/install.mjs",
    "hooks:codex": "node hooks/install.mjs --provider codex",
    "hooks:cursor": "node hooks/install.mjs --provider cursor",
    "hooks:all": "node hooks/install.mjs --all --repair",
    "dist": "npm run build && npm run icons && electron-builder --win",
    "dist:dir": "npm run build && npm run icons && electron-builder --win --dir",
    "publish": "npm run build && npm run icons && electron-builder --win --publish always",
    "debug:app": "node scripts/debug-app.mjs",
    "tm": "node scripts/tm.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.6",
    "mongodb": "^7.6.0",
    "node-pty": "^1.2.0-beta.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.10.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.0.0"
  }
}
